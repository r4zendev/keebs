    switch (combo_index) {
        case CB_CAPS: handle_caps_combo(); return false;
        case CB_UNDO_REDO: tap_morph(C(KC_Z), C(S(KC_Z))); return false;
        case CB_QM_PASTE: tap_morph(KC_PASTE_OS, C(KC_V)); return false;
        case CB_MC_COPY_CUT: tap_morph(C(KC_C), C(KC_X)); return false;
        case CB_TMUX_PREFIX: tap_code16(C(KC_A)); return false;
        case CB_YO_APOS: tap_code16(KC_GRV); return false;
        case CB_SHCHA: tap_code16(KC_O); return false;
        case CB_HARD_SIGN: tap_code16(KC_RBRC); return false;
        case CB_V_COMMA_EXCL: tap_morph(S(KC_SLSH), S(KC_1)); return false;
        case CB_V_DOT_QMARK: tap_morph(KC_SLSH, S(KC_7)); return false;
