     &none    &kp F11     &kp F6     &kp F5     &kp F4    &kp DOT   &none   &none   &none   &none   &none   &none     &kp N0     &kp N4      &kp N5     &kp N6  &kp MINUS      &none
     &none      &none      &none      &none      &none      &trans      &trans   &none   &none      &trans      &trans       &none      &none      &none      &none      &none
            >;
        };

        layer_Magic {
