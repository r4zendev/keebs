/* Graphite + Vestnik — ZMK keymap. See README.md for full docs.
 *
 * Layers: Graphite(0) Vestnik(1) Symbol(2) Nav(3) Num(4) Magic(5)
 * HRM: GACS — GUI(pinky) ALT(ring) CTL(mid) SFT(index) F13(inner)
 * Mod-morphs: '→_  -→"  ,→;  .→?
 *
 * Config:
 *   #define BILATERAL         — positional hold-tap (opt-in)
 *   #define OPERATING_SYSTEM  — 1=linux 2=macos 3=windows
 *
 * Adaptive key (★) — left thumb (tap=★, hold=⇧), 300ms window, default: "
 *   SFBs:    R→L  G→S  U→E  E→U  S→C  H→Y  P→H  O→A  W→S  Y→H
 *   Suffixes: A→TION C→TION D→ITION F→Y I→ON J→UST L→ATION
 *             M→ENT N→ION Q→UEN T→MENT V→ER B→LE Z→ATION
 *   Other:   SPC→THE  .→./  /→/* */  #→#include
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define LAYER_Graphite 0
#define LAYER_Vestnik  1
#define LAYER_Symbol   2
#define LAYER_Nav      3
#define LAYER_Num      4
#define LAYER_Magic    5

#ifndef OPERATING_SYSTEM
#define OPERATING_SYSTEM 1 // 1=linux, 2=macos, 3=windows
#endif

#if OPERATING_SYSTEM == 2
    #define _C      LG
    #define _POWER  K_POWER
    #define _HOME   _C(LEFT)
    #define _END    _C(RIGHT)
    #define _LOCK   _C(LC(Q))
#elif OPERATING_SYSTEM == 1
    #define _C      LC
    #define _POWER  C_POWER
    #define _HOME   HOME
    #define _END    END
    #define _LOCK   K_LOCK
#elif OPERATING_SYSTEM == 3
    #define _C      LC
    #define _POWER  C_POWER
    #define _HOME   HOME
    #define _END    END
    #define _LOCK   LG(L)
#endif

#define _SLEEP C_SLEEP

// Symbol overrides for en-US keyboard
#ifndef KEYMAP_DRAWER
#undef  AMPS
#define AMPS  LS(N7)
#undef  AT
#define AT    LS(N2)
#undef  CARET
#define CARET LS(N6)
#undef  COLON
#define COLON LS(SEMI)
#undef  DLLR
#define DLLR  LS(N4)
#undef  DQT
#define DQT   LS(SQT)
#undef  EXCL
#define EXCL  LS(N1)
#undef  GT
#define GT    LS(DOT)
#undef  HASH
#define HASH  LS(N3)
#undef  LBRC
#define LBRC  LS(LBKT)
#undef  LPAR
#define LPAR  LS(N9)
#undef  LT
#define LT    LS(COMMA)
#undef  PIPE
#define PIPE  LS(BSLH)
#undef  PLUS
#define PLUS  LS(EQUAL)
#undef  PRCNT
#define PRCNT LS(N5)
#undef  QMARK
#define QMARK LS(FSLH)
#undef  RBRC
#define RBRC  LS(RBKT)
#undef  RPAR
#define RPAR  LS(N0)
#undef  STAR
#define STAR  LS(N8)
#undef  TILDE
#define TILDE LS(GRAVE)
#undef  UNDER
#define UNDER LS(MINUS)
#endif

// Key position groups for positional hold-tap
#define KEYS_L 23 24 25 26 27  35 36 37 38 39  47 48 49 50 51
#define KEYS_R 28 29 30 31 32  40 41 42 43 44  58 59 60 61 62
#define THUMBS 69 70 73 74

// #define BILATERAL
#define ALPHA_LAYERS LAYER_Graphite LAYER_Vestnik
#define COMBO_TIMEOUT_MS 75

#include <dt-bindings/zmk/mouse.h>

&sk {
    release-after-ms = <1200>;
    quick-release;
    ignore-modifiers;
};

/ {
    macros {
        rgb_ug_status_macro: rgb_ug_status_macro {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        lang_en: lang_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Graphite>, <&kp LC(LS(LG(N1)))>;
        };

        lang_ru: lang_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Vestnik>, <&kp LC(LS(LG(N2)))>;
        };

        lang_ua: lang_ua {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Vestnik>, <&kp LC(LS(LG(N3)))>;
        };

        macro_tion: macro_tion {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T>, <&kp I>, <&kp O>, <&kp N>;
        };

        macro_ition: macro_ition {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I>, <&kp T>, <&kp I>, <&kp O>, <&kp N>;
        };

        macro_ation: macro_ation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A>, <&kp T>, <&kp I>, <&kp O>, <&kp N>;
        };

        macro_on: macro_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O>, <&kp N>;
        };

        macro_ion: macro_ion {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I>, <&kp O>, <&kp N>;
        };

        macro_ent: macro_ent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp N>, <&kp T>;
        };

        macro_ment: macro_ment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M>, <&kp E>, <&kp N>, <&kp T>;
        };

        macro_le: macro_le {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L>, <&kp E>;
        };

        macro_ust: macro_ust {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U>, <&kp S>, <&kp T>;
        };

        macro_uen: macro_uen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U>, <&kp E>, <&kp N>;
        };

        macro_er: macro_er {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp R>;
        };

        macro_the: macro_the {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T>, <&kp H>, <&kp E>;
        };

        macro_dotslash: macro_dotslash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp FSLH>;
        };

        macro_include: macro_include {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I>, <&kp N>, <&kp C>, <&kp L>, <&kp U>, <&kp D>, <&kp E>, <&kp SPC>;
        };

        macro_block_comment: macro_block_comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp STAR>, <&kp SPC>, <&kp SPC>, <&kp STAR>, <&kp FSLH>, <&kp LEFT>, <&kp LEFT>, <&kp LEFT>;
        };


        bt_0: bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };
    };

    behaviors {
        adaptive_key: adaptive_key {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp DQT>;
            // SFB fixes
            ak_r { trigger-keys = <R>; max-prior-idle-ms = <300>; bindings = <&kp L>; };      // rl 0.114%
            ak_e { trigger-keys = <E>; max-prior-idle-ms = <300>; bindings = <&kp U>; };      // eu
            ak_u { trigger-keys = <U>; max-prior-idle-ms = <300>; bindings = <&kp E>; };      // ue 0.090%
            ak_g { trigger-keys = <G>; max-prior-idle-ms = <300>; bindings = <&kp S>; };      // gs 0.102%
            ak_s { trigger-keys = <S>; max-prior-idle-ms = <300>; bindings = <&kp C>; };      // sc 0.087%
            ak_h { trigger-keys = <H>; max-prior-idle-ms = <300>; bindings = <&kp Y>; };      // hy 0.051%
            ak_p { trigger-keys = <P>; max-prior-idle-ms = <300>; bindings = <&kp H>; };      // ph
            ak_f { trigger-keys = <F>; max-prior-idle-ms = <300>; bindings = <&kp Y>; };      // fy
            ak_o { trigger-keys = <O>; max-prior-idle-ms = <300>; bindings = <&kp A>; };      // oa 0.042%
            ak_w { trigger-keys = <W>; max-prior-idle-ms = <300>; bindings = <&kp S>; };      // ws 0.042%
            ak_y { trigger-keys = <Y>; max-prior-idle-ms = <300>; bindings = <&kp H>; };      // yh reverse
            // Completions
            ak_a { trigger-keys = <A>; max-prior-idle-ms = <300>; bindings = <&macro_tion>; };  // ation
            ak_c { trigger-keys = <C>; max-prior-idle-ms = <300>; bindings = <&macro_tion>; };  // ction
            ak_d { trigger-keys = <D>; max-prior-idle-ms = <300>; bindings = <&macro_ition>; }; // dition
            ak_i { trigger-keys = <I>; max-prior-idle-ms = <300>; bindings = <&macro_on>; };    // ion
            ak_j { trigger-keys = <J>; max-prior-idle-ms = <300>; bindings = <&macro_ust>; };   // just
            ak_l { trigger-keys = <L>; max-prior-idle-ms = <300>; bindings = <&macro_ation>; }; // lation
            ak_m { trigger-keys = <M>; max-prior-idle-ms = <300>; bindings = <&macro_ent>; };   // ment
            ak_n { trigger-keys = <N>; max-prior-idle-ms = <300>; bindings = <&macro_ion>; };   // nion
            ak_q { trigger-keys = <Q>; max-prior-idle-ms = <300>; bindings = <&macro_uen>; };   // quen
            ak_t { trigger-keys = <T>; max-prior-idle-ms = <300>; bindings = <&macro_ment>; };  // tment
            ak_v { trigger-keys = <V>; max-prior-idle-ms = <300>; bindings = <&macro_er>; };    // ver
            ak_b { trigger-keys = <B>; max-prior-idle-ms = <300>; bindings = <&macro_le>; };    // ble
            ak_z { trigger-keys = <Z>; max-prior-idle-ms = <300>; bindings = <&macro_ation>; }; // zation
            ak_spc { trigger-keys = <SPACE>; max-prior-idle-ms = <300>; bindings = <&macro_the>; };
            ak_dot { trigger-keys = <DOT>; max-prior-idle-ms = <300>; bindings = <&macro_dotslash>; };
            // Programming
            ak_fslh { trigger-keys = <FSLH>; max-prior-idle-ms = <300>; bindings = <&macro_block_comment>; }; // /★ → /* | */
            ak_hash { trigger-keys = <HASH>; max-prior-idle-ms = <300>; bindings = <&macro_include>; };        // #★ → #include
        };

        adaptive_shift: adaptive_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "ADAPTIVE_SHIFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&adaptive_key>;
        };

        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
#ifdef BILATERAL
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
#endif
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
#ifdef BILATERAL
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
#endif
            bindings = <&kp>, <&kp>;
        };

        w_caps: capsword_and_capslock {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPSWORD_AND_CAPSLOCK";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sqt_under: sqt_and_under {
            compatible = "zmk,behavior-mod-morph";
            label = "SQT_AND_UNDER";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_dqt: minus_and_dqt {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_AND_DQT";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semi: comma_and_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_AND_SEMI";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_qmark: dot_and_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_AND_QMARK";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspc_del: bspc_and_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        behavior_caps_word {
            continue-list = <
                UNDERSCORE MINUS
                BACKSPACE DELETE
                N1 N2 N3 N4 N5 N6 N7 N8 N9 N0
            >;
        };
    };

/*  Combos (alpha layers, 75ms):
 *    48+49 → ESC    49+50 → TAB    59+60 → RET    60+61 → BSPC/DEL   */

    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <48 49>;
            layers = <ALPHA_LAYERS>;
            timeout-ms = <COMBO_TIMEOUT_MS>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <49 50>;
            layers = <ALPHA_LAYERS>;
            timeout-ms = <COMBO_TIMEOUT_MS>;
        };

        combo_enter {
            bindings = <&kp RET>;
            key-positions = <59 60>;
            layers = <ALPHA_LAYERS>;
            timeout-ms = <COMBO_TIMEOUT_MS>;
        };

        combo_bspc {
            bindings = <&bspc_del>;
            key-positions = <60 61>;
            layers = <ALPHA_LAYERS>;
            timeout-ms = <COMBO_TIMEOUT_MS>;
        };

        // Cyrillic extras (Vestnik only): Щ, Ё/Ґ, Ъ/Ї
        combo_shcha {
            bindings = <&kp O>;
            key-positions = <31 32>;
            layers = <LAYER_Vestnik>;
            timeout-ms = <COMBO_TIMEOUT_MS>;
        };

        combo_yo {
            bindings = <&kp GRAVE>;
            key-positions = <32 44>;
            layers = <LAYER_Vestnik>;
            timeout-ms = <COMBO_TIMEOUT_MS>;
        };

        combo_hard_sign {
            bindings = <&kp RBKT>;
            key-positions = <44 62>;
            layers = <LAYER_Vestnik>;
            timeout-ms = <COMBO_TIMEOUT_MS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

/*  Graphite — home row mods (GACS) + magic thumb (★/⇧)
 *  ╭────────────────────╮ ╭────────────────────╮
 *  │  B   L   D   W   Z │ │ '_  F   O   U   J  │
 *  │  N   R   T   S   G │ │ Y   H   A   E   I  │
 *  │    GUI ALT CTL SFT F13  F13 SFT CTL ALT GUI │
 *  │  X   Q   M   C   V │ │ K   P   -"  ,!  .? │
 *  ╰──────────╮NAV ★/⇧  │ │ SPC SYM╭───────────╯
 *             ╰──────────╯ ╰────────╯            */
        layer_Graphite {
            bindings = <
     &none   &none   &none   &none          &none                                                                                           &none          &none          &none          &none          &none
     &none   &none   &none   &none          &none          &none                                                                    &none   &none          &none          &none          &none          &none
     &none   &kp B   &kp L   &kp D          &kp W          &kp Z                                                       &sqt_under   &kp F          &kp O          &kp U          &kp J          &none
     &none   &hml LGUI N   &hml LALT R   &hml LCTRL T   &hml LSHFT S   &hml F13 G                                         &hmr F13 Y   &hmr RSHFT H   &hmr RCTRL A   &hmr RALT E   &hmr RGUI I   &none
     &none   &kp X   &kp Q   &kp M          &kp C          &kp V   &none   &none   &none   &none   &none   &none   &kp K   &kp P    &minus_dqt   &comma_semi        &dot_qmark          &none
     &magic LAYER_Magic 0   &none   &none   &none   &none   &mo LAYER_Nav   &adaptive_shift LSHFT 0   &none   &none   &kp SPC   &mo LAYER_Symbol   &none   &none   &none   &none   &magic LAYER_Magic 0
            >;
        };

/*  Vestnik — Cyrillic via ЙЦУКЕН keycodes + home row mods
 *  ╭────────────────────╮ ╭────────────────────╮
 *  │  Ц   Д   Р   Г   Х │ │ Ф   П   А   Я   Э │
 *  │  С   Т   Н   К   Б │ │ Ь   В   О   Е   И │
 *  │    GUI ALT CTL SFT F13  F13 SFT CTL ALT GUI │
 *  │  Ш   З   Л   М   Ч │ │ Ж   Й   Ы   У   Ю │
 *  ╰──────────╮NAV SFT  │ │ SPC SYM╭───────────╯
 *             ╰──────────╯ ╰────────╯            */
        layer_Vestnik {
            bindings = <
     &none     &none     &none     &none          &none                                                                                              &none          &none          &none          &none          &none
     &none     &none     &none     &none          &none          &none                                                                       &none   &none          &none          &none          &none          &none
     &none     &kp W     &kp L     &kp H          &kp U       &kp LBKT                                                                      &kp A   &kp G          &kp F          &kp Z        &kp SQT          &none
     &none   &hml LGUI C   &hml LALT N   &hml LCTRL Y   &hml LSHFT R   &hml F13 COMMA                                       &hmr F13 M   &hmr RSHFT D   &hmr RCTRL J   &hmr RALT T   &hmr RGUI B   &none
     &none     &kp I     &kp P     &kp K          &kp V          &kp X   &none   &none   &none   &none   &none   &none   &kp SEMI   &kp Q   &kp S          &kp E        &kp DOT          &none
     &magic LAYER_Magic 0   &none   &none   &none   &none   &mo LAYER_Nav   &kp LSHFT   &none   &none   &kp SPC   &mo LAYER_Symbol   &none   &none   &none   &none   &magic LAYER_Magic 0
            >;
        };

/*  Symbol — all symbols, activated by right outer thumb (74)
 *  ╭────────────────────╮ ╭────────────────────╮
 *  │  `   ~   #   &   | │ │ ^   {   }   [   ]  │
 *  │  !   _   :   =   $ │ │ @   (   )   '   ;  │
 *  │  %   ?   *   +   \ │ │ /   -   <   >   "  │
 *  ╰──────────╮NUM  ▽   │ │ ✕  [SYM]╭──────────╯
 *             ╰──────────╯ ╰─────────╯           */
        layer_Symbol {
            bindings = <
     &none      &none      &none      &none      &none                                                                                          &none       &none       &none      &none      &none
     &none      &none      &none      &none      &none      &none                                                                       &none   &none       &none       &none      &none      &none
     &none  &kp GRAVE  &kp TILDE   &kp HASH   &kp AMPS   &kp PIPE                                                                  &kp CARET   &kp LBRC   &kp RBRC  &kp LBKT  &kp RBKT      &none
     &none   &kp EXCL  &kp UNDER  &kp COLON  &kp EQUAL   &kp DLLR                                                                     &kp AT   &kp LPAR   &kp RPAR    &kp SQT   &kp SEMI      &none
     &none  &kp PRCNT  &kp QMARK   &kp STAR   &kp PLUS   &kp BSLH   &none   &none   &none   &none   &none   &none   &kp FSLH  &kp MINUS      &kp LT     &kp GT    &kp DQT      &none
     &none      &none      &none      &none      &none   &mo LAYER_Num      &trans   &none   &none      &none      &none   &none      &none      &none      &none      &none
            >;
        };

/*  Nav — L: edit + sticky mods, R: arrows + browser/tab + lang
 *  ╭────────────────────────╮ ╭────────────────────────╮
 *  │ Esc  W←   W→   ⌫    ⌦ │ │PgUp Home  ↑   End  UA │
 *  │ sk❖ sk⌥  sk⌃  sk⇧  CW │ │PgDn  ←    ↓    →   RU │
 *  │Undo Cut  Copy Pste Rdo │ │ B←   B→   T←   T→  EN │
 *  ╰──────────╮[NAV] ___    │ │ M1  NUM ╭──────────────╯
 *             ╰──────────────╯ ╰─────────╯               */
        layer_Nav {
            bindings = <
     &none      &none      &none      &none      &none                                                                                                     &none       &none      &none       &none       &none
     &none      &none      &none      &none      &none          &none                                                                              &none   &none       &none      &none       &none       &none
     &none    &kp ESC  &kp LG(COMMA)  &kp LG(DOT)  &kp BSPC    &kp DEL                                                                       &kp PG_UP   &kp _HOME    &kp UP     &kp _END    &lang_ua       &none
     &none   &sk LGUI   &sk LALT   &sk LCTRL  &sk LSHFT   &w_caps                                                                          &kp PG_DN    &kp LEFT  &kp DOWN   &kp RIGHT    &lang_ru       &none
     &none  &kp _C(Z)  &kp _C(X)  &kp _C(C)  &kp _C(V)  &kp _C(LS(Z))   &none   &none   &none   &none   &none   &none  &kp LA(LEFT)  &kp LA(RIGHT)  &kp LC(LS(TAB))  &kp LC(TAB)   &lang_en       &none
     &none      &none      &none      &none      &none         &trans      &none   &none   &none   &mkp LCLK   &mo LAYER_Num   &none      &none      &none       &none       &none
            >;
        };

/*  Num — L: F-keys + HRM, R: numpad + HRM (1-3 home row)
 *  ╭────────────────────────╮ ╭────────────────────────╮
 *  │ F12  F9   F8   F7   = │ │  +   7   8   9   /    │
 *  │❖F10 ⌥F3  ⌃F2  ⇧F1  ↵ │ │  ,  ⇧1  ⌃2  ⌥3  ❖*   │
 *  │ F11  F6   F5   F4   . │ │  0   4   5   6   -    │
 *  ╰──────────╮  ▽    ▽    │ │  ▽    ▽ ╭──────────────╯
 *             ╰─────────────╯ ╰─────────╯              */
        layer_Num {
            bindings = <
     &none      &none      &none      &none      &none                                                                                             &none       &none       &none      &none      &none
     &none      &none      &none      &none      &none      &none                                                                          &none   &none       &none       &none      &none      &none
