/* Graphite + Vestnik — shared base keymap.
 *
 * Layers: Graphite(0) Vestnik(1) Symbol(2) Nav(3) Num(4) Fn(5) Mouse(6) Magic(7)
 * HRM: GACS — GUI(pinky) ALT(ring) CTL(mid) SFT(index)
 * Mod-morphs: '→"  -→/  .→?  ,→!
 *
 * Thumb cluster (34-key):
 *   LH2 = tap:Esc→Tab  hold:Nav
 *   LH1 = tap:repeat  hold:Shift
 *   RH1 = tap:Space→Enter  hold:Num
 *   RH2 = tap:Bspc→Del  hold:Symbol
 *
 * Thumb combos:
 *   LH1+RH1 = System layer (toggle)
 *   LH1+LH2 = Smart-Mouse (auto-deactivate)
 *   RH1+RH2 = Function layer (sticky)
 *
 * Config:
 *   #define BILATERAL        — positional hold-tap + HRM-combo hack (opt-in)
 *   #define OPERATING_SYSTEM — 1=linux 2=macos 3=windows
 *   Comment out MAGIC_SEQUENCES to disable adaptive key suffix completions
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/* ── Layer indices ────────────────────────────────────────────────────── */

#define LAYER_Graphite 0
#define LAYER_Vestnik  1
#define LAYER_Symbol   2
#define LAYER_Nav      3
#define LAYER_Num      4
#define LAYER_Fn       5
#define LAYER_Mouse    6
#define LAYER_Magic    7

/* ── OS-specific keycodes ─────────────────────────────────────────────── */

#ifndef OPERATING_SYSTEM
#define OPERATING_SYSTEM 1
#endif

#if OPERATING_SYSTEM == 2
    #define _C      LG
    #define _POWER  K_POWER
    #define _HOME   _C(LEFT)
    #define _END    _C(RIGHT)
    #define _LOCK   _C(LC(Q))
    #define _SHUTDOWN K_POWER
    #define _PASTE  LG(V)
    #define _SCR_FULL  LG(LS(N3))
    #define _SCR_AREA  LG(LS(N4))
    #define _COLORPICK LG(LS(X))
    #define _FULLSCR   LG(LS(F))
#elif OPERATING_SYSTEM == 1
    #define _C      LC
    #define _POWER  C_POWER
    #define _HOME   HOME
    #define _END    END
    #define _LOCK   LG(LS(L))
    #define _SHUTDOWN LG(LC(LS(Q)))
    #define _PASTE  LC(LS(V))
    #define _SCR_FULL  LG(LS(P))
    #define _SCR_AREA  LG(LS(S))
    #define _COLORPICK LG(LS(X))
    #define _FULLSCR   LG(LS(F))
#elif OPERATING_SYSTEM == 3
    #define _C      LC
    #define _POWER  C_POWER
    #define _HOME   HOME
    #define _END    END
    #define _LOCK   LG(L)
    #define _SHUTDOWN C_POWER
    #define _PASTE  LC(V)
    #define _SCR_FULL  LG(LS(S))
    #define _SCR_AREA  LG(LS(S))
    #define _COLORPICK LG(LS(X))
    #define _FULLSCR   LG(LS(F))
#endif

#define _SLEEP C_SLEEP

/* ── Keycode aliases (shifted symbols) ────────────────────────────────── */

#ifndef KEYMAP_DRAWER
#undef AMPS
#undef AT
#undef CARET
#undef COLON
#undef DLLR
#undef DQT
#undef EXCL
#undef GT
#undef HASH
#undef LBRC
#undef LPAR
#undef LT
#undef PIPE
#undef PLUS
#undef PRCNT
#undef QMARK
#undef RBRC
#undef RPAR
#undef STAR
#undef TILDE
#undef UNDER
#define AMPS  LS(N7)
#define AT    LS(N2)
#define CARET LS(N6)
#define COLON LS(SEMI)
#define DLLR  LS(N4)
#define DQT   LS(SQT)
#define EXCL  LS(N1)
#define GT    LS(DOT)
#define HASH  LS(N3)
#define LBRC  LS(LBKT)
#define LPAR  LS(N9)
#define LT    LS(COMMA)
#define PIPE  LS(BSLH)
#define PLUS  LS(EQUAL)
#define PRCNT LS(N5)
#define QMARK LS(FSLH)
#define RBRC  LS(RBKT)
#define RPAR  LS(N0)
#define STAR  LS(N8)
#define TILDE LS(GRAVE)
#define UNDER LS(MINUS)
#endif

/* ── Key positions ────────────────────────────────────────────────────── */

#define KEYS_L LT0 LT1 LT2 LT3 LT4  LM0 LM1 LM2 LM3 LM4  LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4  RM0 RM1 RM2 RM3 RM4  RB0 RB1 RB2 RB3 RB4
#define THUMBS LH2 LH1 RH1 RH2

/* ── Configuration ────────────────────────────────────────────────────── */

#define BILATERAL
// #define MAGIC_SEQUENCES
#define ALPHA_LAYERS LAYER_Graphite LAYER_Vestnik
#define QUICK_TAP_MS 175

#define COMBO_TERM 30
#define COMBO_IDLE 50

#ifdef MAGIC_SEQUENCES
#define AK(name, k, b) \
    name { trigger-keys = <k>; max-prior-idle-ms = <600>; bindings = <b>; };
#endif

#include <zmk-helpers/helper.h>

/* ── Mouse pointing ───────────────────────────────────────────────────── */

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <dt-bindings/zmk/pointing.h>

&mmv {
  acceleration-exponent = <1>;
  time-to-max-speed-ms = <250>;
  delay-ms = <0>;
};

&msc {
  acceleration-exponent = <0>;
  time-to-max-speed-ms = <300>;
  delay-ms = <0>;
};

#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define U_WH_U &msc SCRL_UP
#define U_WH_D &msc SCRL_DOWN
#define U_WH_L &msc SCRL_LEFT
#define U_WH_R &msc SCRL_RIGHT

/* ── Global behavior config ──────────────────────────────────────────── */

&sk {
    release-after-ms = <1200>;
    quick-release;
    ignore-modifiers;
};

&sl {
    ignore-modifiers;
};

/* ── Macros ───────────────────────────────────────────────────────────── */

/ {
    macros {
        lang_en: lang_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Graphite>, <&kp LC(LS(LG(N1)))>;
        };

        lang_ru: lang_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Vestnik>, <&kp LC(LS(LG(N2)))>;
        };

    };
};

ZMK_MACRO(bt_0, bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;)
ZMK_MACRO(bt_1, bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;)
ZMK_MACRO(bt_2, bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;)
ZMK_MACRO(bt_3, bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;)

#ifdef MAGIC_SEQUENCES
ZMK_MACRO(macro_tion, wait-ms = <0>; tap-ms = <0>; bindings = <&kp T>, <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ation, wait-ms = <0>; tap-ms = <0>; bindings = <&kp A>, <&kp T>, <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ust, wait-ms = <0>; tap-ms = <0>; bindings = <&kp U>, <&kp S>, <&kp T>;)
ZMK_MACRO(macro_uen, wait-ms = <0>; tap-ms = <0>; bindings = <&kp U>, <&kp E>, <&kp N>;)
ZMK_MACRO(macro_the, wait-ms = <0>; tap-ms = <0>; bindings = <&kp T>, <&kp H>, <&kp E>;)
#endif


/* ── Behaviors ────────────────────────────────────────────────────────── */

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
#ifdef BILATERAL
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
#endif
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <150>;
#ifdef BILATERAL
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
#endif
            bindings = <&kp>, <&kp>;
        };

        sqt_dqt: sqt_and_dqt {
            compatible = "zmk,behavior-mod-morph";
            label = "SQT_AND_DQT";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_slash: minus_and_slash {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_AND_SLASH";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp FSLH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_qmark: dot_and_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_AND_QMARK";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_excl: comma_and_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(N1)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        undo_redo: undo_and_redo {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>, <&kp LC(LS(Z))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        v_comma_excl: v_comma_and_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(FSLH)>, <&kp LS(N1)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        v_dot_qmark: v_dot_and_qmark {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp LS(N7)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        copy_cut: copy_and_cut {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp _C(C)>, <&kp _C(X)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspc_del: bspc_and_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        caps_morph: caps_word_lock {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        behavior_caps_word {
            continue-list = <
                UNDERSCORE MINUS
                BACKSPACE DELETE
                N1 N2 N3 N4 N5 N6 N7 N8 N9 N0
            >;
        };
    };
};

/* ── Thumb hold-taps ──────────────────────────────────────────────────── */

ZMK_MOD_MORPH(esc_morph, bindings = <&kp ESC>, <&kp TAB>;
              mods = <(MOD_LSFT|MOD_RSFT)>;)
ZMK_MOD_MORPH(spc_morph, bindings = <&kp SPACE>, <&kp RET>;
              mods = <(MOD_LSFT|MOD_RSFT)>;)
ZMK_HOLD_TAP(lt_spc, bindings = <&mo>, <&spc_morph>;
             flavor = "balanced"; tapping-term-ms = <200>;
             quick-tap-ms = <QUICK_TAP_MS>;)
ZMK_HOLD_TAP(lt_esc, bindings = <&mo>, <&esc_morph>;
             flavor = "balanced"; tapping-term-ms = <200>;
             quick-tap-ms = <QUICK_TAP_MS>;)
ZMK_HOLD_TAP(lt_bspc, bindings = <&mo>, <&bspc_del>;
             flavor = "balanced"; tapping-term-ms = <200>;
             quick-tap-ms = <QUICK_TAP_MS>;)

/* ── Thumb shift (repeat / magic) ────────────────────────────────────── */

#ifdef MAGIC_SEQUENCES

ZMK_ADAPTIVE_KEY(adaptive_key, bindings = <&key_repeat>;
    AK(ak_u, U, &kp E)
    AK(ak_h, H, &kp Y)
    AK(ak_w, W, &kp S)
    AK(ak_a, A, &macro_tion)
    AK(ak_j, J, &macro_ust)
    AK(ak_q, Q, &macro_uen)
    AK(ak_z, Z, &macro_ation)
    AK(ak_spc, SPACE, &macro_the)
)

ZMK_ADAPTIVE_KEY(adaptive_key_ru, bindings = <&key_repeat>;
    AK(ak_ru_h, H, &kp Y)
    AK(ak_ru_y, Y, &kp H)
    AK(ak_ru_p, P, &kp L)
    AK(ak_ru_x, X, &kp R)
    AK(ak_ru_k, K, &kp Y)
)

ZMK_HOLD_TAP(thumb_shift, bindings = <&kp>, <&adaptive_key>;
             flavor = "balanced"; tapping-term-ms = <200>;
             quick-tap-ms = <QUICK_TAP_MS>;)
ZMK_HOLD_TAP(thumb_shift_ru, bindings = <&kp>, <&adaptive_key_ru>;
             flavor = "balanced"; tapping-term-ms = <200>;
             quick-tap-ms = <QUICK_TAP_MS>;)

#define THUMB_SHIFT_EN &thumb_shift LSHFT 0
#define THUMB_SHIFT_RU &thumb_shift_ru LSHFT 0

#else

ZMK_HOLD_TAP(thumb_shift, bindings = <&kp>, <&key_repeat>;
             flavor = "balanced"; tapping-term-ms = <200>;
             quick-tap-ms = <QUICK_TAP_MS>;)

#define THUMB_SHIFT_EN &thumb_shift LSHFT 0
#define THUMB_SHIFT_RU &thumb_shift LSHFT 0

#endif



/* ── Combos ───────────────────────────────────────────────────────────── */

ZMK_COMBO(caps, &caps_morph, LT2 RT2, ALPHA_LAYERS, COMBO_TERM, COMBO_IDLE)

// Horizontal — bottom row
ZMK_COMBO(undo_redo,      &undo_redo,  LB4 LB3, ALPHA_LAYERS, COMBO_TERM, COMBO_IDLE)
ZMK_COMBO(qm_paste,        &kp _PASTE,  LB1 LB2, ALPHA_LAYERS, COMBO_TERM, COMBO_IDLE)
ZMK_COMBO(mc_copy_cut,     &copy_cut,   LB2 LB3, ALPHA_LAYERS, COMBO_TERM, COMBO_IDLE)

// Vestnik-specific combos
ZMK_COMBO(yo_apos,     &kp GRAVE,    RT0 RT1, LAYER_Vestnik, COMBO_TERM, COMBO_IDLE)
ZMK_COMBO(shcha,       &kp O,        LT4 LT3, LAYER_Vestnik, COMBO_TERM, COMBO_IDLE)
ZMK_COMBO(hard_sign,   &kp RBKT,     RT3 RT4, LAYER_Vestnik, COMBO_TERM, COMBO_IDLE)
ZMK_COMBO(v_comma_excl, &v_comma_excl, LM4 LB4, LAYER_Vestnik, COMBO_TERM, COMBO_IDLE)
ZMK_COMBO(v_dot_qmark,  &v_dot_qmark, RM4 RB4, LAYER_Vestnik, COMBO_TERM, COMBO_IDLE)

// Thumb combos
ZMK_COMBO(system_combo, &tog LAYER_Magic,  LH1 RH1, ALPHA_LAYERS, COMBO_TERM, COMBO_IDLE)
ZMK_COMBO(mouse_combo,  &mo LAYER_Mouse,   LH1 LH2, ALPHA_LAYERS, COMBO_TERM, COMBO_IDLE)
ZMK_COMBO(fn_combo,     &sl LAYER_Fn,      RH1 RH2, ALPHA_LAYERS, COMBO_TERM, COMBO_IDLE)

/* ── Layers ───────────────────────────────────────────────────────────── */

#ifndef ZMK_BASE_LAYER
#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH) \
    ZMK_LAYER(name, LT RT LM RM LB RB LH RH)
#endif

ZMK_BASE_LAYER(Graphite,
    &kp B          &kp L          &kp D          &kp W          &kp Z         ,
    &kp J          &kp F          &kp O          &kp U          &comma_excl   ,
    &hml LGUI N    &hml LALT R    &hml LCTRL T   &hml LSHFT S   &kp G         ,
    &kp Y          &hmr RSHFT H   &hmr RCTRL A   &hmr RALT E    &hmr RGUI I   ,
    &kp X          &kp Q          &kp M          &kp C          &kp V         ,
    &kp K          &kp P          &sqt_dqt       &minus_slash    &dot_qmark    ,
    &lt_esc LAYER_Nav 0        THUMB_SHIFT_EN                                     ,
    &lt_spc LAYER_Num 0        &lt_bspc LAYER_Symbol 0
)

ZMK_BASE_LAYER(Vestnik,
    &kp W          &kp L          &kp H          &kp U          &kp LBKT      ,
    &kp A          &kp G          &kp F          &kp Z          &kp SQT       ,
    &hml LGUI C    &hml LALT N    &hml LCTRL Y   &hml LSHFT R   &kp COMMA     ,
    &kp M          &hmr RSHFT D   &hmr RCTRL J   &hmr RALT T    &hmr RGUI B   ,
    &kp I          &kp P          &kp K          &kp V          &kp X         ,
    &kp SEMI       &kp Q          &kp S          &kp E          &kp DOT       ,
    &lt_esc LAYER_Nav 0        THUMB_SHIFT_RU                                     ,
    &lt_spc LAYER_Num 0        &lt_bspc LAYER_Symbol 0
)

ZMK_BASE_LAYER(Symbol,
    &kp TILDE  &kp HASH   &kp STAR   &kp AMPS   &kp GRAVE     ,
    &kp DQT    &kp LPAR   &kp RPAR   &kp LBKT   &kp RBKT      ,
    &kp CARET  &kp UNDER  &kp COLON  &kp EQUAL  &kp DLLR      ,
    &kp AT     &kp PRCNT  &kp LBRC   &kp RBRC   &kp SEMI      ,
    &kp QMARK  &kp EXCL   &kp PIPE   &kp PLUS   &kp FSLH      ,
    &kp BSLH   &kp MINUS  &kp LT     &kp GT     &kp SQT       ,
    &none      &trans                                            ,
    &none      &trans
)

ZMK_BASE_LAYER(Nav,
    &none         &kp LG(COMMA)  &kp LG(DOT)  &none            &none        ,
    &kp PG_UP     &kp _HOME      &kp UP        &kp _END         &lang_en     ,
    &kp LGUI      &kp LALT       &kp LCTRL     &kp LSHFT        &none        ,
    &kp PG_DN     &kp LEFT       &kp DOWN      &kp RIGHT        &lang_ru     ,
    &none         &kp LC(LS(TAB)) &kp LC(TAB)  &kp LC(A)        &none        ,
    &none         &none          &none          &none            &none        ,
    &trans         &none                                                       ,
    &kp RET        &kp TAB
)

ZMK_BASE_LAYER(Num,
    &kp MINUS      &kp N9         &kp N8         &kp N7         &kp PLUS      ,
    &kp UNDER      &none          &none          &none          &none         ,
    &kp COLON      &kp N3         &kp N2         &kp N1         &kp DOT       ,
    &kp EQUAL      &kp RSHFT      &kp RCTRL      &kp RALT       &kp RGUI     ,
    &kp FSLH       &kp N6         &kp N5         &kp N4         &kp STAR      ,
    &kp PRCNT      &none          &none          &none          &none         ,
    &kp COMMA      &kp N0                                                      ,
    &trans         &none
)

ZMK_BASE_LAYER(Fn,
    &kp F12            &kp F9           &kp F8            &kp F7             &kp C_PREV ,
    &none              &none            &none             &none              &none ,
    &kp F11            &kp F3           &kp F2            &kp F1             &kp C_PP ,
    &none              &kp RSHFT        &kp RCTRL         &kp RALT           &kp RGUI ,
    &kp F10            &kp F6           &kp F5            &kp F4             &kp C_NEXT ,
    &none              &none            &none             &none              &none ,
    &kp C_MUTE         &kp LG(F9)                                                   ,
    &trans             &trans
)

ZMK_BASE_LAYER(Mouse,
    &none      &none      &none      &none      &none         ,
    &kp PG_UP  U_WH_L     U_MS_U     U_WH_R     &none         ,
    &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHFT  &none         ,
    &kp PG_DN  U_MS_L     U_MS_D     U_MS_R     &none         ,
    &none      &none      &none      &none      &none         ,
    &none      &mkp LCLK  &mkp MCLK  &mkp RCLK  &none         ,
    &none      &none                                            ,
    U_WH_U     U_WH_D
)
