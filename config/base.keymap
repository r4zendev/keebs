/* Graphite + Vestnik — shared base keymap. See README.md for full docs.
 *
 * Layers: Graphite(0) Vestnik(1) Symbol(2) Nav(3) Num(4) Magic(5)
 * HRM: GACS — GUI(pinky) ALT(ring) CTL(mid) SFT(index) F13(inner)
 * Mod-morphs: ,→-  '→"  :→;  .→?
 *
 * Config:
 *   #define BILATERAL         — positional hold-tap (opt-in)
 *   #define OPERATING_SYSTEM  — 1=linux 2=macos 3=windows
 *
 * Adaptive key (★) — left thumb (tap=★, hold=⇧), 300ms window, default: repeat
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define LAYER_Graphite 0
#define LAYER_Vestnik  1
#define LAYER_Symbol   2
#define LAYER_Nav      3
#define LAYER_Num      4
#define LAYER_Magic    5

#ifndef OPERATING_SYSTEM
#define OPERATING_SYSTEM 1
#endif

#if OPERATING_SYSTEM == 2
    #define _C      LG
    #define _POWER  K_POWER
    #define _HOME   _C(LEFT)
    #define _END    _C(RIGHT)
    #define _LOCK   _C(LC(Q))
#elif OPERATING_SYSTEM == 1
    #define _C      LC
    #define _POWER  C_POWER
    #define _HOME   HOME
    #define _END    END
    #define _LOCK   K_LOCK
#elif OPERATING_SYSTEM == 3
    #define _C      LC
    #define _POWER  C_POWER
    #define _HOME   HOME
    #define _END    END
    #define _LOCK   LG(L)
#endif

#define _SLEEP C_SLEEP

#ifndef KEYMAP_DRAWER
#undef AMPS
#undef AT
#undef CARET
#undef COLON
#undef DLLR
#undef DQT
#undef EXCL
#undef GT
#undef HASH
#undef LBRC
#undef LPAR
#undef LT
#undef PIPE
#undef PLUS
#undef PRCNT
#undef QMARK
#undef RBRC
#undef RPAR
#undef STAR
#undef TILDE
#undef UNDER
#define AMPS  LS(N7)
#define AT    LS(N2)
#define CARET LS(N6)
#define COLON LS(SEMI)
#define DLLR  LS(N4)
#define DQT   LS(SQT)
#define EXCL  LS(N1)
#define GT    LS(DOT)
#define HASH  LS(N3)
#define LBRC  LS(LBKT)
#define LPAR  LS(N9)
#define LT    LS(COMMA)
#define PIPE  LS(BSLH)
#define PLUS  LS(EQUAL)
#define PRCNT LS(N5)
#define QMARK LS(FSLH)
#define RBRC  LS(RBKT)
#define RPAR  LS(N0)
#define STAR  LS(N8)
#define TILDE LS(GRAVE)
#define UNDER LS(MINUS)
#endif

#define KEYS_L LT0 LT1 LT2 LT3 LT4  LM0 LM1 LM2 LM3 LM4  LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4  RM0 RM1 RM2 RM3 RM4  RB0 RB1 RB2 RB3 RB4
#define THUMBS LH2 LH1 RH1 RH2

// #define BILATERAL
#define ALPHA_LAYERS LAYER_Graphite LAYER_Vestnik
#define COMBO_TIMEOUT_MS 75

#define AK(name, k, b) \
    name { trigger-keys = <k>; max-prior-idle-ms = <300>; bindings = <b>; };

#include <zmk-helpers/helper.h>
#include <dt-bindings/zmk/mouse.h>

&sk {
    release-after-ms = <1200>;
    quick-release;
    ignore-modifiers;
};

/ {
    macros {
        lang_en: lang_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Graphite>, <&kp LC(LS(LG(N1)))>;
        };

        lang_ru: lang_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Vestnik>, <&kp LC(LS(LG(N2)))>;
        };

        lang_ua: lang_ua {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Vestnik>, <&kp LC(LS(LG(N3)))>;
        };
    };

    behaviors {
        adaptive_key: adaptive_key {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&key_repeat>;
            AK(ak_r, R, &kp L)                       // R★ = RL
            AK(ak_k, K, &kp Y)                       // K★ = KY
            AK(ak_g, G, &kp S)                       // G★ = GS
            AK(ak_u, U, &kp E)                       // U★ = UE
            AK(ak_e, E, &kp U)                       // E★ = EU
            AK(ak_s, S, &kp C)                       // S★ = SC
            AK(ak_h, H, &kp Y)                       // H★ = HY
            AK(ak_p, P, &kp H)                       // P★ = PH
            AK(ak_o, O, &kp A)                       // O★ = OA
            AK(ak_f, F, &kp Y)                       // F★ = FY
            AK(ak_w, W, &kp S)                       // W★ = WS
            AK(ak_y, Y, &kp H)                       // Y★ = YH
            AK(ak_a, A, &macro_tion)                 // A★ = ATION
            AK(ak_c, C, &macro_tion)                 // C★ = CTION
            AK(ak_d, D, &macro_ition)                // D★ = DITION
            AK(ak_i, I, &macro_on)                   // I★ = ION
            AK(ak_j, J, &macro_ust)                  // J★ = JUST
            AK(ak_l, L, &macro_ation)                // L★ = LATION
            AK(ak_m, M, &macro_ent)                  // M★ = MENT
            AK(ak_n, N, &macro_ion)                  // N★ = NION
            AK(ak_q, Q, &macro_uen)                  // Q★ = QUEN
            AK(ak_t, T, &macro_ment)                 // T★ = TMENT
            AK(ak_z, Z, &macro_ation)                // Z★ = ZATION
            AK(ak_spc, SPACE, &macro_the)            // ␣★ = THE
            AK(ak_dot, DOT, &macro_dotslash)         // .★ = ./
            AK(ak_fslh, FSLH, &macro_block_comment)  // /★ = /*  */
            AK(ak_hash, HASH, &macro_include)        // #★ = #INCLUDE
        };

        adaptive_key_ru: adaptive_key_ru {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&key_repeat>;
            AK(ak_ru_h, H, &kp Y)
            AK(ak_ru_y, Y, &kp H)
            AK(ak_ru_p, P, &kp L)
            AK(ak_ru_x, X, &kp R)
            AK(ak_ru_k, K, &kp Y)
        };

        adaptive_shift: adaptive_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "ADAPTIVE_SHIFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&adaptive_key>;
        };

        adaptive_shift_ru: adaptive_shift_ru {
            compatible = "zmk,behavior-hold-tap";
            label = "ADAPTIVE_SHIFT_RU";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&adaptive_key_ru>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
#ifdef BILATERAL
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
#endif
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
#ifdef BILATERAL
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
#endif
            bindings = <&kp>, <&kp>;
        };

        w_caps: capsword_and_capslock {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPSWORD_AND_CAPSLOCK";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_minus: comma_and_minus {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_AND_MINUS";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp MINUS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sqt_dqt: sqt_and_dqt {
            compatible = "zmk,behavior-mod-morph";
            label = "SQT_AND_DQT";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        colon_semi: colon_and_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_AND_SEMI";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_qmark: dot_and_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_AND_QMARK";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspc_del: bspc_and_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        behavior_caps_word {
            continue-list = <
                UNDERSCORE MINUS
                BACKSPACE DELETE
                N1 N2 N3 N4 N5 N6 N7 N8 N9 N0
            >;
        };
    };
};

ZMK_MACRO(macro_tion,          wait-ms = <0>; tap-ms = <0>; bindings = <&kp T>, <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ition,         wait-ms = <0>; tap-ms = <0>; bindings = <&kp I>, <&kp T>, <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ation,         wait-ms = <0>; tap-ms = <0>; bindings = <&kp A>, <&kp T>, <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_on,            wait-ms = <0>; tap-ms = <0>; bindings = <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ion,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ent,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp E>, <&kp N>, <&kp T>;)
ZMK_MACRO(macro_ment,          wait-ms = <0>; tap-ms = <0>; bindings = <&kp M>, <&kp E>, <&kp N>, <&kp T>;)
ZMK_MACRO(macro_ust,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp U>, <&kp S>, <&kp T>;)
ZMK_MACRO(macro_uen,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp U>, <&kp E>, <&kp N>;)
ZMK_MACRO(macro_the,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp T>, <&kp H>, <&kp E>;)
ZMK_MACRO(macro_dotslash,      wait-ms = <0>; tap-ms = <0>; bindings = <&kp DOT>, <&kp FSLH>;)
ZMK_MACRO(macro_include,       wait-ms = <0>; tap-ms = <0>; bindings = <&kp I>, <&kp N>, <&kp C>, <&kp L>, <&kp U>, <&kp D>, <&kp E>, <&kp SPC>;)
ZMK_MACRO(macro_block_comment, wait-ms = <0>; tap-ms = <0>; bindings = <&kp STAR>, <&kp SPC>, <&kp SPC>, <&kp STAR>, <&kp FSLH>, <&kp LEFT>, <&kp LEFT>, <&kp LEFT>;)

ZMK_MACRO(macro_wq,     wait-ms = <0>; tap-ms = <0>; bindings = <&kp COLON>, <&kp W>, <&kp Q>, <&kp RET>;)
ZMK_MACRO(macro_q_bang, wait-ms = <0>; tap-ms = <0>; bindings = <&kp COLON>, <&kp Q>, <&kp EXCL>, <&kp RET>;)
ZMK_MACRO(macro_w,      wait-ms = <0>; tap-ms = <0>; bindings = <&kp COLON>, <&kp W>, <&kp RET>;)

ZMK_MACRO(bt_0, bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;)
ZMK_MACRO(bt_1, bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;)
ZMK_MACRO(bt_2, bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;)
ZMK_MACRO(bt_3, bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;)

#undef COMBO_TERM
#define COMBO_TERM COMBO_TIMEOUT_MS
ZMK_COMBO(esc,       &kp ESC,   LB3 LB2, ALPHA_LAYERS)
ZMK_COMBO(tab,       &kp TAB,   LB2 LB1, ALPHA_LAYERS)
ZMK_COMBO(enter,     &kp RET,   RB1 RB2, ALPHA_LAYERS)
ZMK_COMBO(bspc,      &bspc_del, RB2 RB3, ALPHA_LAYERS)
ZMK_COMBO(shcha,     &kp O,     RT3 RT4, LAYER_Vestnik)
ZMK_COMBO(yo,        &kp GRAVE, RT4 RM4, LAYER_Vestnik)
ZMK_COMBO(hard_sign, &kp RBKT,  RM4 RB4, LAYER_Vestnik)

ZMK_COMBO(lbkt,  &kp LBKT,  LT1 LM1, ALPHA_LAYERS)
ZMK_COMBO(lpar,  &kp LPAR,  LT2 LM2, ALPHA_LAYERS)
ZMK_COMBO(lbrc,  &kp LBRC,  LT3 LM3, ALPHA_LAYERS)
ZMK_COMBO(combo_lt, &kp LT,  LT4 LM4, ALPHA_LAYERS)
ZMK_COMBO(rbkt,  &kp RBKT,  RT3 RM3, ALPHA_LAYERS)
ZMK_COMBO(rpar,  &kp RPAR,  RT2 RM2, ALPHA_LAYERS)
ZMK_COMBO(rbrc,  &kp RBRC,  RT1 RM1, ALPHA_LAYERS)
ZMK_COMBO(combo_gt, &kp GT,  RT0 RM0, ALPHA_LAYERS)

ZMK_COMBO(vim_wq, &macro_wq,     LB2 LB3, LAYER_Nav)
ZMK_COMBO(vim_q,  &macro_q_bang, LB1 LB2, LAYER_Nav)
ZMK_COMBO(vim_w,  &macro_w,      LB3 LB4, LAYER_Nav)
