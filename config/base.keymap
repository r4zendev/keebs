/* Graphite + Vestnik — shared base keymap. See README.md for full docs.
 *
 * Layers: Graphite(0) Vestnik(1) Symbol(2) Nav(3) Num(4) Magic(5)
 * HRM: GACS — GUI(pinky) ALT(ring) CTL(mid) SFT(index)
 * Mod-morphs: '→"  :→;  .→?
 *
 * Config:
 *   #define BILATERAL         — positional hold-tap (opt-in)
 *   #define OPERATING_SYSTEM  — 1=linux 2=macos 3=windows
 *
 * Adaptive key (★) — left thumb (tap=★, hold=⇧), 300ms window, default: repeat
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define LAYER_Graphite 0
#define LAYER_Vestnik  1
#define LAYER_Symbol   2
#define LAYER_Nav      3
#define LAYER_Num      4
#define LAYER_Magic    5

#ifndef OPERATING_SYSTEM
#define OPERATING_SYSTEM 1
#endif

#if OPERATING_SYSTEM == 2
    #define _C      LG
    #define _POWER  K_POWER
    #define _HOME   _C(LEFT)
    #define _END    _C(RIGHT)
    #define _LOCK   _C(LC(Q))
    #define _SHUTDOWN K_POWER
    #define _PASTE  LG(V)
    #define _SCR_FULL  LG(LS(N3))
    #define _SCR_AREA  LG(LS(N4))
    #define _COLORPICK LG(LS(X))
    #define _FULLSCR   LG(LS(F))
#elif OPERATING_SYSTEM == 1
    #define _C      LC
    #define _POWER  C_POWER
    #define _HOME   HOME
    #define _END    END
    #define _LOCK   LG(LS(L))
    #define _SHUTDOWN LG(LC(LS(Q)))
    #define _PASTE  LC(LS(V))
    #define _SCR_FULL  LG(LS(P))
    #define _SCR_AREA  LG(LS(S))
    #define _COLORPICK LG(LS(X))
    #define _FULLSCR   LG(LS(F))
#elif OPERATING_SYSTEM == 3
    #define _C      LC
    #define _POWER  C_POWER
    #define _HOME   HOME
    #define _END    END
    #define _LOCK   LG(L)
    #define _SHUTDOWN C_POWER
    #define _PASTE  LC(V)
    #define _SCR_FULL  LG(LS(S))
    #define _SCR_AREA  LG(LS(S))
    #define _COLORPICK LG(LS(X))
    #define _FULLSCR   LG(LS(F))
#endif

#define _SLEEP C_SLEEP

#ifndef KEYMAP_DRAWER
#undef AMPS
#undef AT
#undef CARET
#undef COLON
#undef DLLR
#undef DQT
#undef EXCL
#undef GT
#undef HASH
#undef LBRC
#undef LPAR
#undef LT
#undef PIPE
#undef PLUS
#undef PRCNT
#undef QMARK
#undef RBRC
#undef RPAR
#undef STAR
#undef TILDE
#undef UNDER
#define AMPS  LS(N7)
#define AT    LS(N2)
#define CARET LS(N6)
#define COLON LS(SEMI)
#define DLLR  LS(N4)
#define DQT   LS(SQT)
#define EXCL  LS(N1)
#define GT    LS(DOT)
#define HASH  LS(N3)
#define LBRC  LS(LBKT)
#define LPAR  LS(N9)
#define LT    LS(COMMA)
#define PIPE  LS(BSLH)
#define PLUS  LS(EQUAL)
#define PRCNT LS(N5)
#define QMARK LS(FSLH)
#define RBRC  LS(RBKT)
#define RPAR  LS(N0)
#define STAR  LS(N8)
#define TILDE LS(GRAVE)
#define UNDER LS(MINUS)
#endif

#define KEYS_L LT0 LT1 LT2 LT3 LT4  LM0 LM1 LM2 LM3 LM4  LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4  RM0 RM1 RM2 RM3 RM4  RB0 RB1 RB2 RB3 RB4
#define THUMBS LH2 LH1 RH1 RH2

// #define BILATERAL
#define ALPHA_LAYERS LAYER_Graphite LAYER_Vestnik
#define COMBO_TIMEOUT_MS 75

#define AK(name, k, b) \
    name { trigger-keys = <k>; max-prior-idle-ms = <300>; bindings = <b>; };

#include <zmk-helpers/helper.h>
#include <dt-bindings/zmk/mouse.h>

&sk {
    release-after-ms = <1200>;
    quick-release;
    ignore-modifiers;
};

/ {
    macros {
        lang_en: lang_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Graphite>, <&kp LC(LS(LG(N1)))>;
        };

        lang_ru: lang_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Vestnik>, <&kp LC(LS(LG(N2)))>;
        };

        lang_ua: lang_ua {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Vestnik>, <&kp LC(LS(LG(N3)))>;
        };
    };

    behaviors {
        adaptive_key: adaptive_key {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&key_repeat>;
            AK(ak_r, R, &kp L)                       // R★ = RL
            AK(ak_k, K, &kp Y)                       // K★ = KY
            AK(ak_g, G, &kp S)                       // G★ = GS
            AK(ak_u, U, &kp E)                       // U★ = UE
            AK(ak_e, E, &kp U)                       // E★ = EU
            AK(ak_s, S, &kp C)                       // S★ = SC
            AK(ak_h, H, &kp Y)                       // H★ = HY
            AK(ak_p, P, &kp H)                       // P★ = PH
            AK(ak_o, O, &kp A)                       // O★ = OA
            AK(ak_f, F, &kp Y)                       // F★ = FY
            AK(ak_w, W, &kp S)                       // W★ = WS
            AK(ak_y, Y, &kp H)                       // Y★ = YH
            AK(ak_a, A, &macro_tion)                 // A★ = ATION
            AK(ak_c, C, &macro_tion)                 // C★ = CTION
            AK(ak_d, D, &macro_ition)                // D★ = DITION
            AK(ak_i, I, &macro_on)                   // I★ = ION
            AK(ak_j, J, &macro_ust)                  // J★ = JUST
            AK(ak_l, L, &macro_ation)                // L★ = LATION
            AK(ak_m, M, &macro_ent)                  // M★ = MENT
            AK(ak_n, N, &macro_ion)                  // N★ = NION
            AK(ak_q, Q, &macro_uen)                  // Q★ = QUEN
            AK(ak_t, T, &macro_ment)                 // T★ = TMENT
            AK(ak_z, Z, &macro_ation)                // Z★ = ZATION
            AK(ak_spc, SPACE, &macro_the)            // ␣★ = THE
            AK(ak_dot, DOT, &macro_dotslash)         // .★ = ./
            AK(ak_fslh, FSLH, &macro_block_comment)  // /★ = /*  */
            AK(ak_hash, HASH, &macro_include)        // #★ = #INCLUDE
        };

        adaptive_key_ru: adaptive_key_ru {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&key_repeat>;
            AK(ak_ru_h, H, &kp Y)
            AK(ak_ru_y, Y, &kp H)
            AK(ak_ru_p, P, &kp L)
            AK(ak_ru_x, X, &kp R)
            AK(ak_ru_k, K, &kp Y)
        };

        adaptive_shift: adaptive_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "ADAPTIVE_SHIFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&adaptive_key>;
        };

        adaptive_shift_ru: adaptive_shift_ru {
            compatible = "zmk,behavior-hold-tap";
            label = "ADAPTIVE_SHIFT_RU";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&adaptive_key_ru>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
#ifdef BILATERAL
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
#endif
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
#ifdef BILATERAL
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
#endif
            bindings = <&kp>, <&kp>;
        };

        w_caps: capsword_and_capslock {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPSWORD_AND_CAPSLOCK";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sqt_dqt: sqt_and_dqt {
            compatible = "zmk,behavior-mod-morph";
            label = "SQT_AND_DQT";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        colon_semi: colon_and_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_AND_SEMI";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_qmark: dot_and_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_AND_QMARK";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_excl: comma_and_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(N1)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspc_del: bspc_and_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        behavior_caps_word {
            continue-list = <
                UNDERSCORE MINUS
                BACKSPACE DELETE
                N1 N2 N3 N4 N5 N6 N7 N8 N9 N0
            >;
        };
    };
};

ZMK_MACRO(macro_tion,          wait-ms = <0>; tap-ms = <0>; bindings = <&kp T>, <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ition,         wait-ms = <0>; tap-ms = <0>; bindings = <&kp I>, <&kp T>, <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ation,         wait-ms = <0>; tap-ms = <0>; bindings = <&kp A>, <&kp T>, <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_on,            wait-ms = <0>; tap-ms = <0>; bindings = <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ion,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp I>, <&kp O>, <&kp N>;)
ZMK_MACRO(macro_ent,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp E>, <&kp N>, <&kp T>;)
ZMK_MACRO(macro_ment,          wait-ms = <0>; tap-ms = <0>; bindings = <&kp M>, <&kp E>, <&kp N>, <&kp T>;)
ZMK_MACRO(macro_ust,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp U>, <&kp S>, <&kp T>;)
ZMK_MACRO(macro_uen,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp U>, <&kp E>, <&kp N>;)
ZMK_MACRO(macro_the,           wait-ms = <0>; tap-ms = <0>; bindings = <&kp T>, <&kp H>, <&kp E>;)
ZMK_MACRO(macro_dotslash,      wait-ms = <0>; tap-ms = <0>; bindings = <&kp DOT>, <&kp FSLH>;)
ZMK_MACRO(macro_include,       wait-ms = <0>; tap-ms = <0>; bindings = <&kp I>, <&kp N>, <&kp C>, <&kp L>, <&kp U>, <&kp D>, <&kp E>, <&kp SPC>;)
ZMK_MACRO(macro_block_comment, wait-ms = <0>; tap-ms = <0>; bindings = <&kp STAR>, <&kp SPC>, <&kp SPC>, <&kp STAR>, <&kp FSLH>, <&kp LEFT>, <&kp LEFT>, <&kp LEFT>;)


ZMK_MACRO(bt_0, bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;)
ZMK_MACRO(bt_1, bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;)
ZMK_MACRO(bt_2, bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;)
ZMK_MACRO(bt_3, bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;)

#undef COMBO_TERM
#define COMBO_TERM COMBO_TIMEOUT_MS
ZMK_COMBO(esc,       &kp ESC,   LB3 LB2, ALPHA_LAYERS)
ZMK_COMBO(tab,       &kp TAB,   LB2 LB1, ALPHA_LAYERS)
ZMK_COMBO(enter,     &kp RET,   RB1 RB2, ALPHA_LAYERS)
ZMK_COMBO(bspc,      &bspc_del, RB2 RB3, ALPHA_LAYERS)
ZMK_COMBO(lpar,     &kp LPAR, LT2 LM2, ALPHA_LAYERS)
ZMK_COMBO(rpar,     &kp RPAR, RT2 RM2, ALPHA_LAYERS)

ZMK_COMBO(lbkt,     &kp LBKT, LT3 LM3, LAYER_Graphite)
ZMK_COMBO(lbrc,     &kp LBRC, LT1 LM1, LAYER_Graphite)
ZMK_COMBO(combo_lt, &kp LT,   LT0 LM0, LAYER_Graphite)
ZMK_COMBO(rbkt,     &kp RBKT, RT3 RM3, LAYER_Graphite)
ZMK_COMBO(rbrc,     &kp RBRC, RT1 RM1, LAYER_Graphite)
ZMK_COMBO(combo_gt, &kp GT,   RT0 RM0, LAYER_Graphite)

ZMK_COMBO(v_dquote,    &kp LS(N2),   LT1 LT0, LAYER_Vestnik)
ZMK_COMBO(yo_apos,     &kp GRAVE,    RT0 RT1, LAYER_Vestnik)
ZMK_COMBO(v_colon,     &kp LS(N6),   LT0 LM0, LAYER_Vestnik)
ZMK_COMBO(v_semi,      &kp LS(N4),   RT0 RM0, LAYER_Vestnik)
ZMK_COMBO(shcha,       &kp O,        LB0 LB1, LAYER_Vestnik)
ZMK_COMBO(hard_sign,   &kp RBKT,     RB0 RB1, LAYER_Vestnik)
ZMK_COMBO(v_excl,      &kp LS(N1),   LM4 LB4, LAYER_Vestnik)
ZMK_COMBO(v_qmark,     &kp LS(N7),   RM4 RB4, LAYER_Vestnik)
ZMK_COMBO(v_comma,     &kp LS(FSLH), LB3 LB4, LAYER_Vestnik)
ZMK_COMBO(v_period,    &kp FSLH,     RB3 RB4, LAYER_Vestnik)

ZMK_COMBO(capsword,    &w_caps,      LM0 RM0, ALPHA_LAYERS)

#ifndef ZMK_BASE_LAYER
#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH) \
    ZMK_LAYER(name, LT RT LM RM LB RB LH RH)
#endif

ZMK_BASE_LAYER(Graphite,
    &kp B   &kp L   &kp D          &kp W          &kp Z         ,
    &kp J   &kp F          &kp O          &kp U          &comma_excl   ,
    &hml LGUI N   &hml LALT R   &hml LCTRL T   &hml LSHFT S   &kp G    ,
    &kp Y   &hmr RSHFT H   &hmr RCTRL A   &hmr RALT E   &hmr RGUI I    ,
    &kp X   &kp Q   &kp M          &kp C          &kp V         ,
    &kp K   &kp P    &sqt_dqt   &colon_semi        &dot_qmark    ,
    &mo LAYER_Nav   &adaptive_shift LSHFT 0                      ,
    &kp SPC   &mo LAYER_Symbol
)

ZMK_BASE_LAYER(Vestnik,
    &kp W     &kp L     &kp H          &kp U       &kp LBKT      ,
    &kp A     &kp G          &kp F          &kp Z        &kp SQT   ,
    &hml LGUI C   &hml LALT N   &hml LCTRL Y   &hml LSHFT R   &kp COMMA ,
    &kp M   &hmr RSHFT D   &hmr RCTRL J   &hmr RALT T   &hmr RGUI B    ,
    &kp I     &kp P     &kp K          &kp V          &kp X         ,
    &kp SEMI   &kp Q   &kp S          &kp E        &kp DOT       ,
    &mo LAYER_Nav   &adaptive_shift_ru LSHFT 0                    ,
    &kp SPC   &mo LAYER_Symbol
)

ZMK_BASE_LAYER(Symbol,
    &kp TILDE  &kp HASH   &kp PLUS   &kp STAR   &kp GRAVE     ,
    &kp BSLH   &kp LPAR   &kp RPAR   &kp LBKT   &kp RBKT      ,
    &kp EXCL   &kp EQUAL  &kp UNDER  &kp FSLH   &kp DLLR      ,
    &kp AT     &sk LSHFT  &sk LCTRL  &sk LALT   &sk LGUI       ,
    &kp PRCNT  &kp PIPE   &kp AMPS   &kp MINUS  &kp CARET     ,
    &kp QMARK  &kp LBRC   &kp RBRC   &kp LT     &kp GT        ,
    &mo LAYER_Num      &trans                                     ,
    &none      &none
)

ZMK_BASE_LAYER(Nav,
    &kp LG(F9)    &kp LG(COMMA)  &kp LG(DOT)  &kp LC(LS(TAB))  &kp LC(TAB) ,
    &kp PG_UP   &kp _HOME    &kp UP     &kp _END    &lang_ua      ,
    &sk LGUI   &sk LALT   &sk LCTRL  &sk LSHFT   &kp LC(A)          ,
    &kp PG_DN    &kp LEFT  &kp DOWN   &kp RIGHT    &lang_ru      ,
    &kp _C(Z)  &kp _C(X)  &kp _C(C)  &kp _PASTE  &kp _C(LS(Z)) ,
    &kp LA(LEFT)  &kp LA(RIGHT)  &kp _SCR_AREA  &kp _SCR_FULL  &lang_en ,
    &trans      &none                                              ,
    &kp _C(BSPC)   &mo LAYER_Num
)

ZMK_BASE_LAYER(Num,
    &kp F12     &kp F9     &kp F8     &kp F7  &kp EQUAL         ,
    &kp PLUS    &kp N7      &kp N8     &kp N9   &kp FSLH        ,
    &hml LGUI F10  &hml LALT F3  &hml LCTRL F2  &hml LSHFT F1   &kp RET ,
    &kp COMMA  &hmr RSHFT N1  &hmr RCTRL N2  &hmr RALT N3  &hmr RGUI STAR ,
    &kp F11     &kp F6     &kp F5     &kp F4    &kp DOT          ,
    &kp N0     &kp N4      &kp N5     &kp N6  &kp MINUS         ,
    &trans      &none                                              ,
    &none      &trans
)
