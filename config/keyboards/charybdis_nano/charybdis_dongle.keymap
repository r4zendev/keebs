/* Charybdis dongle (central) — reuses the Charybdis layout.
 * Lives at the keyboard root (alongside charybdis_nano.keymap) so the
 * build symlinks it next to base.keymap and the include resolves. */

#include <zmk-helpers/key-labels/36.h>

#undef THUMBS
#define THUMBS LH1 LH0 RH0 RH1

#undef LH_NONE
#define LH_NONE &mo LAYER_Num

#undef RH_NONE
#define RH_NONE &kp ESC

#include "base.keymap"
