/* Same letter map as the matrix probe:
 *   1 2 3 4 5 6   7 8 9 0 a b
 *   c d e f g h   i j k l m n
 *   o p q r s t   u v w x y z
 *       , . /     ; ' -
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
  keymap {
    compatible = "zmk,keymap";
    probe_layer {
      display-name = "DiodeProbe";
      bindings = <
        &kp N1    &kp N2  &kp N3   &kp N4   &kp N5    &kp N6      &kp N7    &kp N8   &kp N9    &kp N0  &kp A  &kp B
        &kp C     &kp D   &kp E    &kp F    &kp G     &kp H       &kp I     &kp J    &kp K     &kp L   &kp M  &kp N
        &kp O     &kp P   &kp Q    &kp R    &kp S     &kp T       &kp U     &kp V    &kp W     &kp X   &kp Y  &kp Z
                          &kp COMMA &kp DOT &kp FSLH              &kp SEMI  &kp SQT  &kp MINUS
      >;
    };
  };
};
