/* Pin-identification probe: every exposed GPIO is a direct-pin key with a
 * pull-up. Ground a pad and it types its letter. Used to verify the
 * controller module actually routes each pad to the nice!nano-standard pin.
 *
 *   A  = pro_micro 0  (P0.08)      L = pro_micro 14 (P1.11)
 *   B  = pro_micro 1  (P0.06)      M = pro_micro 15 (P1.13)
 *   C  = pro_micro 2  (P0.17) row1 N = pro_micro 16 (P0.10) col1
 *   D  = pro_micro 3  (P0.20) col6 O = pro_micro 18 (P1.15)
 *   E  = pro_micro 4  (P0.22) col4 P = pro_micro 19 (P0.02)
 *   F  = pro_micro 5  (P0.24) col3 Q = pro_micro 20 (P0.29)
 *   G  = pro_micro 6  (P1.00) col2 R = pro_micro 21 (P0.31)
 *   H  = pro_micro 7  (P0.11) col5 S = P1.01 (extra pad)
 *   I  = pro_micro 8  (P1.04) row2 T = P1.02 (extra pad)
 *   J  = pro_micro 9  (P1.06) row3 U = P1.07 (extra pad)
 *   K  = pro_micro 10 (P0.09) row4
 */

#include <dt-bindings/zmk/matrix_transform.h>

&uicr {
    nfct-pins-as-gpios;
};

&pro_micro_serial {
    status = "disabled";
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <21>;
        rows = <1>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)
            RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(0,14) RC(0,15) RC(0,16) RC(0,17) RC(0,18) RC(0,19) RC(0,20)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };
};
