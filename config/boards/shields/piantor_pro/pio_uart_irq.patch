@@ -140,6 +148,133 @@ static void pio_uart_poll_out(const struct device *dev, unsigned char c)
 	pio_sm_put_blocking(pio_rpi_pico_get_pio(config->piodev), data->tx_sm, (uint32_t)c);
 }
 
+#ifdef CONFIG_UART_INTERRUPT_DRIVEN
+
+static int pio_uart_fifo_fill(const struct device *dev, const uint8_t *tx_data, int size)
+{
+	const struct pio_uart_config *config = dev->config;
+	struct pio_uart_data *data = dev->data;
+	PIO pio = pio_rpi_pico_get_pio(config->piodev);
+	int i;
+
+	for (i = 0; i < size; i++) {
+		if (pio_sm_is_tx_fifo_full(pio, data->tx_sm)) {
+			break;
+		}
+		pio_sm_put(pio, data->tx_sm, (uint32_t)tx_data[i]);
+	}
+	return i;
+}
+
+static int pio_uart_fifo_read(const struct device *dev, uint8_t *rx_data, const int size)
+{
+	const struct pio_uart_config *config = dev->config;
+	struct pio_uart_data *data = dev->data;
+	PIO pio = pio_rpi_pico_get_pio(config->piodev);
+	io_rw_8 *uart_rx_fifo_msb;
+	int i;
+
+	uart_rx_fifo_msb = (io_rw_8 *)&pio->rxf[data->rx_sm] + 3;
+	for (i = 0; i < size; i++) {
+		if (pio_sm_is_rx_fifo_empty(pio, data->rx_sm)) {
+			break;
+		}
+		rx_data[i] = (uint8_t)*uart_rx_fifo_msb;
+	}
+	return i;
+}
+
+static void pio_uart_irq_tx_enable(const struct device *dev)
+{
+	const struct pio_uart_config *config = dev->config;
+	struct pio_uart_data *data = dev->data;
+	PIO pio = pio_rpi_pico_get_pio(config->piodev);
+
+	data->tx_irq_enabled = true;
+	pio_set_irq0_source_enabled(pio, pis_sm0_tx_fifo_not_full + data->tx_sm, true);
+	irq_enable(config->irq_num);
+}
+
+static void pio_uart_irq_tx_disable(const struct device *dev)
+{
+	const struct pio_uart_config *config = dev->config;
+	struct pio_uart_data *data = dev->data;
+	PIO pio = pio_rpi_pico_get_pio(config->piodev);
+
+	data->tx_irq_enabled = false;
+	pio_set_irq0_source_enabled(pio, pis_sm0_tx_fifo_not_full + data->tx_sm, false);
+}
+
+static void pio_uart_irq_rx_enable(const struct device *dev)
+{
+	const struct pio_uart_config *config = dev->config;
+	struct pio_uart_data *data = dev->data;
+	PIO pio = pio_rpi_pico_get_pio(config->piodev);
+
+	data->rx_irq_enabled = true;
+	pio_set_irq0_source_enabled(pio, pis_sm0_rx_fifo_not_empty + data->rx_sm, true);
+	irq_enable(config->irq_num);
+}
+
+static void pio_uart_irq_rx_disable(const struct device *dev)
+{
+	const struct pio_uart_config *config = dev->config;
+	struct pio_uart_data *data = dev->data;
+	PIO pio = pio_rpi_pico_get_pio(config->piodev);
+
+	data->rx_irq_enabled = false;
+	pio_set_irq0_source_enabled(pio, pis_sm0_rx_fifo_not_empty + data->rx_sm, false);
+}
+
+static int pio_uart_irq_tx_ready(const struct device *dev)
+{
+	const struct pio_uart_config *config = dev->config;
+	struct pio_uart_data *data = dev->data;
+	PIO pio = pio_rpi_pico_get_pio(config->piodev);
+
+	return data->tx_irq_enabled && !pio_sm_is_tx_fifo_full(pio, data->tx_sm);
+}
+
+static int pio_uart_irq_rx_ready(const struct device *dev)
+{
+	const struct pio_uart_config *config = dev->config;
+	struct pio_uart_data *data = dev->data;
+	PIO pio = pio_rpi_pico_get_pio(config->piodev);
+
+	return data->rx_irq_enabled && !pio_sm_is_rx_fifo_empty(pio, data->rx_sm);
+}
+
+static int pio_uart_irq_is_pending(const struct device *dev)
+{
+	return pio_uart_irq_rx_ready(dev) || pio_uart_irq_tx_ready(dev);
+}
+
+static int pio_uart_irq_update(const struct device *dev)
+{
+	return 1;
+}
+
+static void pio_uart_irq_callback_set(const struct device *dev,
+				       uart_irq_callback_user_data_t cb,
+				       void *user_data)
+{
+	struct pio_uart_data *data = dev->data;
+
+	data->irq_cb = cb;
+	data->irq_cb_data = user_data;
+}
+
+static void pio_uart_isr(const struct device *dev)
+{
+	struct pio_uart_data *data = dev->data;
+
+	if (data->irq_cb) {
+		data->irq_cb(dev, data->irq_cb_data);
+	}
+}
+
+#endif /* CONFIG_UART_INTERRUPT_DRIVEN */
+
 static int pio_uart_init(const struct device *dev)
 {
 	const struct pio_uart_config *config = dev->config;
@@ -173,12 +308,35 @@ static int pio_uart_init(const struct device *dev)
