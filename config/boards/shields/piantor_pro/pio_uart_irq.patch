+
+#ifdef CONFIG_UART_INTERRUPT_DRIVEN
+	irq_connect_dynamic(config->irq_num, 0,
+			    (void (*)(const void *))pio_uart_isr, dev, 0);
+#endif
+
+	return 0;
 }
 
