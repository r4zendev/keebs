//╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
    &kp ESC   &kp LG(O)  &kp LG(U)  &none      &none      , &kp PG_UP   &kp _HOME  &kp UP     &kp _END   &lang_ru  ,
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
    &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHFT  &none      ,  &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &lang_en  ,
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
   &kp LG(LA(S)) &kp _SCR_AREA &kp _SCR_FULL &none     &none , &none      &kp TAB    &kp BSPC   &kp DEL    &none     ,
//╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                     LH_NONE &none  &mouse_ht LAYER_Mouse LAYER_Mouse , &kp RET    &none RH_NONE
//                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
)
