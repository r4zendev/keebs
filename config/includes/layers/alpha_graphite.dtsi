ZMK_BASE_LAYER(Graphite,
//╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
    &kp B      &kp L      &kp D      &kp W      &kp Z      ,  &kp J      &kp F      &kp O      &kp U      &comma_excl ,
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
   &hml LGUI N &hml LALT R &hml LCTRL T &hml LSHFT S &kp G ,  &kp Y    &hmr RSHFT H &hmr RCTRL A &hmr RALT E &hmr RGUI I ,
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
    &kp X      &kp Q      &kp M      &kp C      &kp V      ,  &kp K      &kp P      &sqt_dqt   &minus_slash &dot_qmark ,
//╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                    LH_NONE &nav_ht LAYER_Nav 0  &thumb_bspc LSHFT 0 , &thumb_spc LAYER_Symbol SPACE &lt LAYER_Num RET RH_NONE
//                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
)
