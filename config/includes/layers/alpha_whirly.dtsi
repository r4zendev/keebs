/* Whirly — whirl variant with y on the left index. Inactive by default. */

#ifndef WHIRLY_D
#define WHIRLY_D &kp D
#endif
#ifndef WHIRLY_H
#define WHIRLY_H &hml LSHFT H
#endif
#ifndef WHIRLY_X
#define WHIRLY_X &kp X
#endif
#ifndef WHIRLY_P
#define WHIRLY_P &kp P
#endif
#ifndef WHIRLY_MAGIC
#define WHIRLY_MAGIC &num_repeat LAYER_Num 0
#endif

#if WHIRLY_ADAPTIVE
ZMK_ADAPTIVE_KEY(whirly_bigram_d, bindings = <&kp D>;
    whirly_d_s { trigger-keys = <S>; max-prior-idle-ms = <800>; bindings = <&kp C>; strict-modifiers; };
)
ZMK_ADAPTIVE_KEY(whirly_bigram_x, bindings = <&kp X>;
    whirly_x_r { trigger-keys = <R>; max-prior-idle-ms = <800>; bindings = <&kp L>; strict-modifiers; };
)
ZMK_ADAPTIVE_KEY(whirly_bigram_p, bindings = <&kp P>;
    whirly_p_g { trigger-keys = <G>; max-prior-idle-ms = <800>; bindings = <&kp S>; strict-modifiers; };
)
ZMK_ADAPTIVE_KEY(whirly_bigram_h, bindings = <&kp H>;
    whirly_h_n { trigger-keys = <N>; max-prior-idle-ms = <800>; bindings = <&kp G>; strict-modifiers; };
)
ZMK_HOLD_TAP(whirly_hml_h, bindings = <&kp>, <&whirly_bigram_h>;
             flavor = "balanced"; tapping-term-ms = <180>;
             quick-tap-ms = <QUICK_TAP_MS>; require-prior-idle-ms = <100>;
             hold-trigger-key-positions = <KEYS_R THUMBS>;
             hold-trigger-on-release;)

ZMK_ADAPTIVE_KEY(whirly_magic, bindings = <&key_repeat>;
    whirly_m_sqt { trigger-keys = <SQT>; max-prior-idle-ms = <800>; bindings = <&kp R>; };
    whirly_m_w   { trigger-keys = <W>;   max-prior-idle-ms = <800>; bindings = <&kp H>; };
    whirly_m_u   { trigger-keys = <U>;   max-prior-idle-ms = <800>; bindings = <&kp E>; };
    whirly_m_h   { trigger-keys = <H>;   max-prior-idle-ms = <800>; bindings = <&kp Y>; };
    whirly_m_nt  { trigger-keys = <T>; prior-trigger-keys = <N>; max-prior-idle-ms = <800>; bindings = <&kp S>; strict-modifiers; };
    whirly_m_nd  { trigger-keys = <D>; prior-trigger-keys = <N>; max-prior-idle-ms = <800>; bindings = <&kp S>; strict-modifiers; };
)
ZMK_HOLD_TAP(whirly_magic_ht, bindings = <&mo>, <&whirly_magic>;
             flavor = "balanced"; tapping-term-ms = <200>;
             quick-tap-ms = <QUICK_TAP_MS>;)

#undef WHIRLY_D
#undef WHIRLY_H
#undef WHIRLY_X
#undef WHIRLY_P
#undef WHIRLY_MAGIC
#define WHIRLY_D &whirly_bigram_d
#define WHIRLY_H &whirly_hml_h LSHFT 0
#define WHIRLY_X &whirly_bigram_x
#define WHIRLY_P &whirly_bigram_p
#define WHIRLY_MAGIC &whirly_magic_ht LAYER_Num 0
#endif

ZMK_BASE_LAYER(Whirly,
//╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
    &kp B      &kp C      WHIRLY_D   &kp W      &kp K      ,  &kp Q      &kp L      &kp U      &kp O      &kp J      ,
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
   &hml LGUI N &hml LALT S &hml LCTRL T WHIRLY_H &kp Y , &sqt_dqt   &hmr RSHFT R &hmr RCTRL E &hmr RALT A &hmr RGUI I ,
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
    WHIRLY_P   &kp G      &kp M      &kp F      &kp V      ,  &kp Z      WHIRLY_X   &comma_excl &dot_qmark &kp SEMI ,
//╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
        LH_NONE &thumb_bspc LAYER_Nav 0  &thumb_spc LAYER_Symbol SPACE , WHIRLY_MAGIC  &sk LSHFT RH_NONE
//                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
)
