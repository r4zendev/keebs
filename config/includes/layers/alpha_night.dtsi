/* Night — left-thumb alpha (r), right-thumb space. Inactive by default. */

#ifndef NIGHT_O
#define NIGHT_O &kp O
#endif
#ifndef NIGHT_Q
#define NIGHT_Q &kp Q
#endif

#if NIGHT_ADAPTIVE
ZMK_ADAPTIVE_KEY(night_bigram_o, bindings = <&kp O>;
    night_o_u { trigger-keys = <U>; max-prior-idle-ms = <800>; bindings = <&kp E>; strict-modifiers; };
)

/* yq -> y' */
ZMK_ADAPTIVE_KEY(night_bigram_q, bindings = <&kp Q>;
    night_q_y { trigger-keys = <Y>; max-prior-idle-ms = <800>; bindings = <&kp SQT>; strict-modifiers; };
)

#undef NIGHT_O
#undef NIGHT_Q
#define NIGHT_O &night_bigram_o
#define NIGHT_Q &night_bigram_q
#endif

ZMK_BASE_LAYER(Night,
//╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
    &kp B      &kp F      &kp L      &kp D      NIGHT_Q    ,  &kp P      &kp G      NIGHT_O    &kp U      &dot_qmark ,
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
   &hml LGUI N &hml LALT S &hml LCTRL H &hml LSHFT T &kp M , &kp Y      &hmr RSHFT C &hmr RCTRL A &hmr RALT E &hmr RGUI I ,
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
    &kp X      &kp V      &kp J      &kp K      &kp Z      ,  &sqt_dqt   &kp W      &kp SEMI   &minus_slash &comma_excl ,
//╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
        LH_NONE &thumb_bspc LAYER_Nav 0  &thumb_spc LAYER_Mouse R , &thumb_spc LAYER_Symbol SPACE  &num_repeat LAYER_Num 0 RH_NONE
//                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
)
