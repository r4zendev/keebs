/* Indices follow the compiled order in base.keymap (graphite, vestnik-dm,
 * then the utility layers). Toggling which alpha layers are included means
 * updating these to match. */
#define LAYER_Graphite  0
#define LAYER_VestnikDm 1
#define LAYER_Vestnik   LAYER_VestnikDm
#define LAYER_Symbol    2
#define LAYER_Nav       3
#define LAYER_Num       4
#define LAYER_VestnikX  5
#define LAYER_Mouse     6
#define LAYER_Magic     7

#define ALPHA_LAYERS LAYER_Graphite LAYER_VestnikDm
#define CAPS_LAYERS  LAYER_Graphite LAYER_VestnikDm

ZMK_MACRO(to_vestnik,  bindings = <&to LAYER_VestnikDm>;)

#define SYS_SLOT1 &to_graphite
#define SYS_SLOT2 &to_vestnik
#define SYS_SLOT3 &none
