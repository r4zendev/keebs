/* splitkb Aurora Sweep — 34-key board wrapper. */

#include <zmk-helpers/key-labels/36.h>

// 34-key board: remap 4 thumb keys to positions 30-33
#undef LH0
#undef LH1
#undef LH2
#undef RH0
#undef RH1
#undef RH2
#define LH2 30
#define LH1 31
#define RH1 32
#define RH2 33

#include "base.keymap"

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_System {
            bindings = <
     &bootloader   &none         &to_graphite  &to_rain      &to_dusk       &none       &none        &none        &none      &bootloader
     &bt BT_CLR    &bt_0         &bt_1         &bt_2         &bt_3              &soft_off   &kp _LOCK    &kp _SHUTDOWN &kp _SLEEP &out OUT_TOG
     &sys_reset    &none         &none         &none         &none              &none       &none        &none        &none      &sys_reset
                                        &none                &none              &none       &none
            >;
        };

        layer_Rain {
            bindings = <
     &kp F      &kp D      &kp L      &kp G      &kp V          &kp Q      &kp R      &kp U      &kp O      &comma_excl
     &hml LGUI S &hml LALT T &hml LCTRL H &hml LSHFT C &kp Y   &kp J    &hmr RSHFT N &hmr RCTRL E &hmr RALT A &hmr RGUI I
     &kp Z      &kp K      &kp M      &kp P      &kp W          &kp X      &kp B      &sqt_dqt   &minus_slash &dot_qmark
                    &nav_ht LAYER_Nav 0  &thumb_bspc LSHFT 0    &thumb_spc LAYER_Symbol SPACE &lt LAYER_Num RET
            >;
        };

    };
};
